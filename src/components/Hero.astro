---
import SectionContainer from "./ui/SectionContainer.astro"
---

<SectionContainer id="home" className="relative text-white overflow-hidden"
>
    <picture class="w-full max-w-300 block">
        <img
            src="images/hero.webp"
            alt="Exterior view of Posada Leñatero with garden"
            class="w-full h-auto block"
        />
    </picture>

    <div
        class="absolute inset-0 bg-linear-to-b from-black/30 to-black/40 flex justify-center items-center"
    >
        <div class="w-full max-w-245 px-8">
            <div
                class="flex flex-col gap-6 drop-shadow-[2px_2px_8px_rgba(0,0,0,0.6)]"
            >
                <h2 class="text-[2rem] font-extrabold leading-none mb-2">
                    Rest and comfort near the airport
                </h2>

                <p class="text-[1.1rem] font-normal max-w-150 leading-[1.3]">
                    Comfortable rooms in a warm, family-friendly place. Check
                    availability and rates on WhatsApp.
                </p>

                <a
                    href="/"
                    class="self-start inline-flex items-center gap-2.5 bg-[#25d366] text-white px-8 py-3.5 rounded-full font-bold text-[1.2rem] uppercase mt-6 transition-transform duration-200 hover:scale-105"
                    target="_blank"
                    rel="noopener"
                >
                    <img
                        src="icons/whatsapp-icon.svg"
                        class="w-6.25 h-6.25"
                        alt=""
                        aria-hidden="true"
                    />
                    Check Availability
                </a>
            </div>
        </div>
    </div>
</SectionContainer>
