---
import SectionContainer from "@ui/layout/SectionContainer.astro";
import HeroTitle from "@features/hero/HeroTitle.astro";
import HeroBackground from "@features/hero/HeroBackground.astro";
import CTAButton from "@ui/buttons/CTAButton.astro";
---

<SectionContainer
    id="home"
    className="relative text-white overflow-hidden min-h-[85vh] md:min-h-[90vh] flex items-center pt-18"
>
    <HeroBackground
        src="images/hero.webp"
        alt="Exterior view of Posada Leñatero with garden"
    />

    <div class="relative w-full z-10">
        <div class="max-w-4xl px-6 md:px-12 lg:px-20">
            <div
                class="flex flex-col gap-4 md:gap-6 drop-shadow-xl text-center md:text-left items-center md:items-start"
            >
                <HeroTitle>
                    Rest <span class="text-lime-600">near the airport</span>
                </HeroTitle>

                <p
                    class="text-lg md:text-xl lg:text-2xl font-light max-w-xl leading-relaxed opacity-95"
                >
                    Comfortable rooms in a warm, family-friendly place.
                    <span
                        class="hidden sm:inline text-base md:text-lg font-semibold text-lime-600 border-l-2 border-lime-600 pl-4 py-1"
                    >
                        Check availability and rates on WhatsApp.
                    </span>
                </p>

                <CTAButton
                    href="https://wa.me/5491128171332"
                    text="Chat with us now"
                    icon="/icons/whatsapp-icon.svg"
                />
            </div>
        </div>
    </div>
</SectionContainer>
