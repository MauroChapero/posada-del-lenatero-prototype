---
import SectionContainer from "./ui/SectionContainer.astro"
---

<SectionContainer 
  id="home" 
  className="relative text-white overflow-hidden min-h-[85vh] md:min-h-[90vh] flex items-center pt-18" 
>
    
    <picture class="absolute inset-0 w-full h-full">
        <img
            src="images/hero.webp"
            alt="Exterior view of Posada Leñatero with garden"
            class="w-full h-full object-cover object-center"
        />
    </picture>

    <div class="absolute inset-0 bg-black/40 md:bg-linear-to-r md:from-black/60 md:to-transparent"></div>

    <div class="relative w-full z-10">
        <div class="max-w-4xl px-6 md:px-12 lg:px-20">
            <div class="flex flex-col gap-4 md:gap-6 drop-shadow-xl text-center md:text-left items-center md:items-start">
                
                <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black leading-[1.1] tracking-tight uppercase max-w-2xl">
                    Rest and comfort <span class="text-lime-600">near the airport</span>
                </h2>

                <p class="text-lg md:text-xl lg:text-2xl font-light max-w-xl leading-relaxed opacity-95">
                    Comfortable rooms in a warm, family-friendly place. 
                    <span class="hidden sm:inline text-base md:text-lg font-semibold text-lime-600 border-l-2 border-lime-600 pl-4 py-1">Check availability and rates on WhatsApp.</span>
                </p>

                <a
                    href="https://wa.me/5491128171332"
                    class="inline-flex items-center gap-3 bg-lime-600 text-white px-6 py-3 md:px-8 md:py-4 rounded-full font-bold text-base md:text-lg uppercase mt-4 transition-all duration-300 hover:scale-105 hover:bg-lime-600 shadow-lg shadow-lime-600/20"
                    target="_blank"
                    rel="noopener"
                >
                    <img
                        src="icons/whatsapp-icon.svg"
                        class="w-5 h-5 md:w-6 md:h-6 brightness-0 invert"
                        alt=""
                        aria-hidden="true"
                    />
                    Chat with us now
                </a>
            </div>
        </div>
    </div>
</SectionContainer>