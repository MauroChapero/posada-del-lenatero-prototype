---
import FooterLink from "@features/footer/FooterLink.astro";
import { contactDetails, footerCredits } from "@constants/footer";
---

<footer class="bg-[#0f0f0f] py-12 border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col gap-12">
      <div
        class="flex flex-col md:flex-row justify-center items-start md:items-center gap-8 md:gap-16"
      >
        {contactDetails.map((info) => <FooterLink info={info} />)}
      </div>

      <div
        class="flex flex-col items-center text-center gap-3 w-full pt-8 border-t border-white/5"
      >
        <p
          class="text-[10px] text-gray-400 font-bold uppercase tracking-[0.2em] leading-relaxed"
        >
          {footerCredits.brand}
          {footerCredits.year} © by
          <span class="text-white font-black">GonFe®</span>
        </p>

        <p
          class="text-[9px] text-gray-500 font-medium uppercase tracking-widest leading-relaxed"
        >
          Design & Collaboration:
          <a
            href={footerCredits.authorUrl}
            target="_blank"
            class="text-lime-500 font-bold hover:text-white transition-colors duration-300"
          >
            {footerCredits.author}
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
