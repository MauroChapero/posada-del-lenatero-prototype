---
import SectionContainer from "./ui/SectionContainer.astro";

// Ejemplo de cómo estructurar la data
const services = [
  { name: "High-Speed WiFi", icon: "wifi", extra: false },
  { name: "Breakfast Buffet", icon: "coffee", extra: true },
  { name: "Bar Service", icon: "glass", extra: true },
  { name: "TV & DVD", icon: "tv", extra: false },
];
---

<SectionContainer id="services">
  <div class="text-center mb-10">
    <h2 class="text-3xl font-bold uppercase tracking-wider">Services & Amenities</h2>
    <p class="text-gray-600 mt-2">Personalize your stay with our optional services</p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
    {services.map(service => (
      <div class="border p-6 rounded-xl flex flex-col items-center shadow-sm">
        <h3 class="font-semibold">{service.name}</h3>
        {service.extra && <span class="text-xs text-green-600 font-bold uppercase mt-2">Extra Cost</span>}
      </div>
    ))}
  </div>
</section>