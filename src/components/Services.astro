---
import SectionContainer from "@ui/layout/SectionContainer.astro";
import ServiceCard from "@features/services/ServiceCard.astro";
import { servicesI18n } from "@i18n/content";
import { useTranslations } from "@i18n/utils";
import type { Locale } from "@i18n/utils";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const services = servicesI18n[locale];
---

<SectionContainer id="services" hasScrollMargin className="py-24 bg-[#fcfcfc]">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-20">
      <h2 class="text-4xl md:text-5xl mb-[0.2rem] font-bold text-gray-900">
        {t("services.title")} <span class="bg-clip-text text-gray-900">{t("services.titleAccent")}</span>
      </h2>
      <p
        class="text-xl text-gray-500 max-w-2xl mx-auto leading-relaxed font-light"
      >
        {t("services.subtitle" as any)}
      </p>

      <ul class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-3 max-w-4xl mx-auto text-[1.1rem] text-gray-700 font-medium">
        <li class="flex items-center gap-2"><span class="text-lime-600 text-xl">✓</span> {t("services.list.toiletries" as any)}</li>
        <li class="flex items-center gap-2"><span class="text-lime-600 text-xl">✓</span> {t("services.list.towels" as any)}</li>
        <li class="flex items-center gap-2"><span class="text-lime-600 text-xl">✓</span> {t("services.list.aircon" as any)}</li>
        <li class="flex items-center gap-2"><span class="text-lime-600 text-xl">✓</span> {t("services.list.smarttv" as any)}</li>
        <li class="flex items-center gap-2"><span class="text-lime-600 text-xl">✓</span> {t("services.list.parking" as any)}</li>
        <li class="flex items-center gap-2"><span class="text-lime-600 text-xl">✓</span> {t("services.list.reception" as any)}</li>
        <li class="flex items-center gap-2"><span class="text-lime-600 text-xl">✓</span> {t("services.list.transfer" as any)}</li>
      </ul>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      {services.map((service) => <ServiceCard service={service} locale={locale} />)}
    </div>
  </div>
</SectionContainer>
