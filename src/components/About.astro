---
import SectionContainer from "@ui/layout/SectionContainer.astro";
import RatingItem from "@features/about/RatingItem.astro";
import { ratingsI18n } from "@i18n/content";
import { useTranslations } from "@i18n/utils";
import type { Locale } from "@i18n/utils";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const ratings = ratingsI18n[locale];
---

<SectionContainer
  id="about"
  hasScrollMargin
  className="bg-neutral-900 text-white py-16 md:py-24"
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 items-center">
    <div class="space-y-4 text-center lg:text-left">
      <h3
        class="text-4xl sm:text-5xl md:text-6xl font-black uppercase leading-[0.9] tracking-tighter"
      >
        {t("about.title.part1")}<br /><span class="text-lime-600">{t("about.title.part2")}</span>
      </h3>
      <p class="text-neutral-500 text-lg md:text-xl font-medium">
        {t("about.subtitle")}
      </p>
    </div>

    <div
      class="bg-neutral-800/30 p-6 sm:p-8 md:p-10 rounded-3xl border border-neutral-800 mx-4 sm:mx-0"
    >
      <p
        class="uppercase text-[10px] sm:text-xs font-bold text-lime-600 mb-8 md:mb-10 tracking-[0.2em] text-center sm:text-left"
      >
        {t("about.ratingsLabel")}
      </p>

      <ul class="grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-10">
        {ratings.map((rating) => <RatingItem {...rating} />)}
      </ul>
    </div>
  </div>
</SectionContainer>
