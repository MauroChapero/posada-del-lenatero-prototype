---
import NavLink from "@features/navigation/NavLink.astro";
import WhatsAppButton from "@ui/buttons/WhatsAppButton.astro";
import SectionContainer from "@ui/layout/SectionContainer.astro";
import HamburgerButton from "@ui/buttons/HamburgerButton.astro";
import Logo from "@ui/brand/Logo.astro";
import MobileNavLink from "@features/navigation/MobileNavLink.astro";

import { navLinks } from "@constants/navLinks";
import type { NavLink as NavLinkType } from "@types";
---

<header
    class="fixed top-0 left-0 w-full h-20 z-100 bg-white shadow-sm md:backdrop-blur-md pt-[env(safe-area-inset-top)]"
>
    <SectionContainer>
        <nav class="flex items-center justify-between py-4 relative">
            <Logo />
            <ul class="hidden lg:flex items-center gap-8">
                {
                    navLinks.map((link) => (
                        <NavLink href={link.href} name={link.name} />
                    ))
                }
            </ul>

            <div class="flex items-center gap-4 z-1001">
                <div class="hidden sm:block">
                    <WhatsAppButton text="Book Now!" />
                </div>

                <HamburgerButton />
            </div>

            <div
                id="mobile-menu"
                class="fixed inset-0 bg-white translate-x-full transition-transform duration-300 lg:hidden flex flex-col items-center pt-28 gap-8 z-100"
            >
                <ul
                    class="flex flex-col items-center gap-8 text-xl font-bold uppercase tracking-wide"
                >
                    {
                        navLinks.map((link) => (
                            <MobileNavLink href={link.href} name={link.name} />
                        ))
                    }
                </ul>

                <div class="mt-4 sm:hidden">
                    <WhatsAppButton text="Book Now!" />
                </div>
            </div>
        </nav>
    </SectionContainer>
</header>

<script>
    const menuToggle = document.getElementById("menu-toggle");

    const mobileMenu = document.getElementById("mobile-menu");

    const menuLinks = document.querySelectorAll(".mobile-link");

    // Función para bloquear el scroll sin mover la página

    function preventDefault(e) {
        e.preventDefault();
    }

    function toggleMenu() {
        if (!mobileMenu || !menuToggle) return;

        const isMenuOpen = !mobileMenu.classList.contains("translate-x-full");

        if (isMenuOpen) {
            // CERRAR

            mobileMenu.classList.add("translate-x-full");

            menuToggle.classList.remove("active");

            // Habilitamos el scroll de nuevo

            window.removeEventListener("wheel", preventDefault);

            window.removeEventListener("touchmove", preventDefault);
        } else {
            // ABRIR

            mobileMenu.classList.remove("translate-x-full");

            menuToggle.classList.add("active");

            // Bloqueamos el scroll del "fondo" pero permitimos el del menú

            window.addEventListener("wheel", preventDefault, {
                passive: false,
            });

            window.addEventListener("touchmove", preventDefault, {
                passive: false,
            });
        }
    }

    menuToggle?.addEventListener("click", toggleMenu);

    menuLinks.forEach((link) => {
        link.addEventListener("click", () => {
            // Importante: Liberar el scroll antes de navegar

            window.removeEventListener("wheel", preventDefault);

            window.removeEventListener("touchmove", preventDefault);

            mobileMenu?.classList.add("translate-x-full");

            menuToggle?.classList.remove("active");
        });
    });
</script>

<style>
    /* Animación simple para el botón hamburguesa */

    #menu-toggle.active .line-1 {
        transform: translateY(8px) rotate(45deg);
    }

    #menu-toggle.active .line-2 {
        opacity: 0;
    }

    #menu-toggle.active .line-3 {
        transform: translateY(-8px) rotate(-45deg);
    }
</style>
