---
import NavLink from "@features/navigation/NavLink.astro";
import WhatsAppButton from "@ui/buttons/WhatsAppButton.astro";
import SectionContainer from "@ui/layout/SectionContainer.astro";
import HamburgerButton from "@ui/buttons/HamburgerButton.astro";
import Logo from "@ui/brand/Logo.astro";
import MobileNavLink from "@features/navigation/MobileNavLink.astro";

import { useTranslations } from "@i18n/utils";
import { navLinksI18n } from "@i18n/content";
import type { Locale } from "@i18n/utils";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const navLinks = navLinksI18n[locale];
const switchPath = locale === "es" ? "/en/" : "/";
---

<header
    class="fixed top-0 left-0 w-full h-20 z-50 bg-white shadow-sm md:backdrop-blur-md pt-[env(safe-area-inset-top)]"
>
    <SectionContainer>
        <nav class="flex items-center justify-between py-4 relative">
            <Logo />
            <ul class="hidden lg:flex items-center gap-8">
                {
                    navLinks.map((link) => (
                        <NavLink href={link.href} name={link.name} />
                    ))
                }
            </ul>

            <div class="flex items-center gap-4 z-60">
                <a
                    href={switchPath}
                    data-lang-switch
                    class="text-sm font-bold uppercase tracking-wider text-gray-600 hover:text-lime-600 transition-colors px-2 py-1"
                >
                    {t("lang.switchTo")}
                </a>

                <div class="hidden sm:block">
                    <WhatsAppButton text={t("nav.bookNow")} />
                </div>

                <HamburgerButton />
            </div>

            <div
                id="mobile-menu"
                role="dialog"
                aria-label={t("nav.menuLabel" as any)}
                class="fixed inset-0 bg-white translate-x-full transition-transform duration-300 lg:hidden flex flex-col items-center pt-28 gap-8 z-55"
            >
                <ul
                    class="flex flex-col items-center gap-8 text-xl font-bold uppercase tracking-wide"
                >
                    {
                        navLinks.map((link) => (
                            <MobileNavLink href={link.href} name={link.name} />
                        ))
                    }
                </ul>

                <div class="mt-4 sm:hidden">
                    <WhatsAppButton text={t("nav.bookNow")} />
                </div>
            </div>
        </nav>
    </SectionContainer>
</header>

<script>
    import '../scripts/navigation.ts';

    // Language switcher: persist manual choice
    document.querySelector("[data-lang-switch]")?.addEventListener("click", () => {
        try {
            localStorage.setItem("lang-choice", "manual");
        } catch (_) {}
    });
</script>

<style>
    /* Animación simple para el botón hamburguesa */

    #menu-toggle.active .line-1 {
        transform: translateY(8px) rotate(45deg);
    }

    #menu-toggle.active .line-2 {
        opacity: 0;
    }

    #menu-toggle.active .line-3 {
        transform: translateY(-8px) rotate(-45deg);
    }
</style>
