---
import NavLink from "./ui/NavLink.astro";
import WhatsAppButton from "./ui/WhatsAppButton.astro";
import SectionContainer from "./ui/SectionContainer.astro";

const navLinks = [
    { name: "Home", href: "#home" },
    { name: "Rates", href: "#rates" },
    { name: "About Us", href: "#about" },
    { name: "Services", href: "#services" },
    { name: "Showcase", href: "#showcases" },
];

---

<header class="fixed top-0 left-0 w-full h-20 z-100 bg-white shadow-sm md:backdrop-blur-md pt-[env(safe-area-inset-top)]">


    <SectionContainer>
        <nav class="flex items-center justify-between py-4 relative">
            <a href="/" class="shrink-0 z-110">
                <img
                    src="/icons/posadas-navbar-icon.webp"
                    alt="Logo"
                    class="h-10 md:h-12 w-auto"
                />
            </a>

            <ul class="hidden lg:flex items-center gap-8">
                {navLinks.map((link) => (
                    <NavLink href={link.href} name={link.name} />
                ))}
            </ul>

            <div class="flex items-center gap-4 z-110">
                <div class="hidden sm:block">
                    <WhatsAppButton text="Book Now!" />
                </div>

                <button 
                    id="menu-toggle"
                    aria-label="Toggle Menu"
                    class="lg:hidden flex flex-col gap-1.5 p-2 outline-none"
                >
                    <span class="w-6 h-0.5 bg-gray-800 transition-all duration-300 line-1"></span>
                    <span class="w-6 h-0.5 bg-gray-800 transition-all duration-300 line-2"></span>
                    <span class="w-6 h-0.5 bg-gray-800 transition-all duration-300 line-3"></span>
                </button>
            </div>

            <div 
                id="mobile-menu" 
                class="fixed inset-0 bg-white translate-x-full transition-transform duration-300 lg:hidden flex flex-col items-center pt-28 gap-8 z-100"
            >
                <ul class="flex flex-col items-center gap-8 text-xl font-bold uppercase tracking-wide">
                    {navLinks.map((link) => (
                        <li>
                            <a href={link.href} class="mobile-link text-gray-800 hover:text-green-600 transition-colors">
                                {link.name}
                            </a>
                        </li>
                    ))}
                </ul>
                
                <div class="mt-4 sm:hidden">
                    <WhatsAppButton text="Book Now!" />
                </div>
            </div>
        </nav>
    </SectionContainer>
</header>

<script>
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuLinks = document.querySelectorAll('.mobile-link');

    // Función para bloquear el scroll sin mover la página
    function preventDefault(e) {
        e.preventDefault();
    }

    function toggleMenu() {
        if (!mobileMenu || !menuToggle) return;

        const isMenuOpen = !mobileMenu.classList.contains('translate-x-full');

        if (isMenuOpen) {
            // CERRAR
            mobileMenu.classList.add('translate-x-full');
            menuToggle.classList.remove('active');
            // Habilitamos el scroll de nuevo
            window.removeEventListener('wheel', preventDefault);
            window.removeEventListener('touchmove', preventDefault);
        } else {
            // ABRIR
            mobileMenu.classList.remove('translate-x-full');
            menuToggle.classList.add('active');
            // Bloqueamos el scroll del "fondo" pero permitimos el del menú
            window.addEventListener('wheel', preventDefault, { passive: false });
            window.addEventListener('touchmove', preventDefault, { passive: false });
        }
    }

    menuToggle?.addEventListener('click', toggleMenu);

    menuLinks.forEach(link => {
        link.addEventListener('click', () => {
            // Importante: Liberar el scroll antes de navegar
            window.removeEventListener('wheel', preventDefault);
            window.removeEventListener('touchmove', preventDefault);
            mobileMenu?.classList.add('translate-x-full');
            menuToggle?.classList.remove('active');
        });
    });
</script>

<style>
    /* Animación simple para el botón hamburguesa */
    #menu-toggle.active .line-1 { transform: translateY(8px) rotate(45deg); }
    #menu-toggle.active .line-2 { opacity: 0; }
    #menu-toggle.active .line-3 { transform: translateY(-8px) rotate(-45deg); }
</style>