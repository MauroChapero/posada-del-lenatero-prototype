---
import SectionContainer from "@ui/layout/SectionContainer.astro";
import ReviewCard from "@features/reviews/ReviewCard.astro";
import { reviews } from "@constants/reviews";
---

<SectionContainer id="reviews" hasScrollMargin className="py-24 bg-[#fcfcfc]">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-20">
            <h2
                class="text-4xl md:text-5xl mb-[0.2rem] font-bold text-gray-900"
            >
                Guest <span class="text-lime-600">Reviews</span>
            </h2>
            <p
                class="text-xl text-gray-500 max-w-2xl mx-auto leading-relaxed font-light"
            >
                Verified experiences from travelers who have made our house
                their home near EZE Airport.
            </p>
        </div>

        <div class="relative mt-5">
            <div
                id="reviews-wrapper"
                class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-10 lg:gap-12 overflow-hidden max-h-300 lg:max-h-213 transition-[max-height] duration-1000 ease-in-out"
            >
                {reviews.map((review) => <ReviewCard review={review} />)}
            </div>

            <div
                id="reviews-overlay"
                class="absolute bottom-0 left-0 right-0 h-64 bg-linear-to-t from-[#fcfcfc] via-[#fcfcfc]/90 to-transparent flex items-end justify-center pb-8 transition-all duration-500"
            >
                <button
                    id="show-more-reviews"
                    class="group flex items-center gap-3 bg-gray-900 text-white px-10 py-4 rounded-full font-bold uppercase text-[11px] tracking-[0.2em] hover:bg-lime-600 transition-all duration-300 active:scale-95 shadow-xl shadow-gray-200"
                >
                    Read All {reviews.length} Reviews
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-4 h-4 text-lime-400 group-hover:translate-y-1 transition-transform"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="3"
                            d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</SectionContainer>

<script>
    function setupReviews() {
        const button = document.getElementById("show-more-reviews");
        const wrapper = document.getElementById("reviews-wrapper");
        const overlay = document.getElementById("reviews-overlay");

        if (button && wrapper && overlay) {
            button.addEventListener("click", () => {
                // Expandimos el contenedor (un valor alto para que funcione la transición)
                wrapper.style.maxHeight = "5000px";

                // Quitamos el line-clamp de los párrafos para mostrar el texto completo
                const messages = wrapper.querySelectorAll("p.line-clamp-4");
                messages.forEach((msg) => {
                    msg.classList.remove("line-clamp-4");
                });

                // Desvanecemos y eliminamos el botón
                overlay.classList.add("opacity-0", "pointer-events-none");

                setTimeout(() => {
                    overlay.remove();
                }, 500);
            });
        }
    }

    // Ejecutar en carga inicial y cuando Astro cambie de página (si usas View Transitions)
    setupReviews();
    document.addEventListener("astro:after-swap", setupReviews);
</script>
