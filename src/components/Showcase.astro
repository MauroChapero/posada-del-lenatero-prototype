---
// src/components/Showcase.astro
import SectionContainer from "@ui/layout/SectionContainer.astro";
import ShowcaseCard from "@features/showcase/ShowcaseCard.astro";
import GalleryModal from "@features/showcase/GalleryModal.astro";
import { showcaseImages } from "@constants/showcase";

const featuredImages = showcaseImages.slice(0, 4);
---

<SectionContainer
  id="showcases"
  className="bg-neutral-900 text-white py-16 md:py-24"
>
  <div class="text-center mb-12 md:mb-16">
    <h2
      class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight uppercase mb-6"
    >
      Our <span class="text-lime-600">Showcase</span>
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
    {
      featuredImages.map((img, index) => (
        <ShowcaseCard {...img} index={index} />
      ))
    }
  </div>

  <div
    class="mt-12 flex flex-col md:flex-row justify-between items-center gap-6 border-t border-neutral-800 pt-8"
  >
    <p class="text-neutral-500 text-xs uppercase font-bold tracking-widest">
      Showing {featuredImages.length} of {showcaseImages.length} moments
    </p>

    <button
      id="open-gallery"
      class="group flex items-center gap-3 text-sm font-bold uppercase tracking-widest text-white hover:text-lime-600 transition-colors"
    >
      View all photos
      <span
        class="flex items-center justify-center w-10 h-10 rounded-full border border-neutral-700 group-hover:border-lime-600 transition-all"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
          ></path>
        </svg>
      </span>
    </button>
  </div>

  <GalleryModal />
</SectionContainer>
