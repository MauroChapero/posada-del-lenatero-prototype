---
interface Props {
    href: string;
    text: string;
    icon?: string; // El icono es opcional
    className?: string; // Por si quieres añadir margen extra desde el padre
}

const { href, text, icon, className } = Astro.props;
---

<a
    href={href}
    class:list={[
        "inline-flex items-center gap-3 bg-lime-600 text-white px-6 py-3 md:px-8 md:py-4 rounded-full font-bold text-base md:text-lg uppercase transition-all duration-300 hover:scale-105 hover:bg-lime-700 shadow-lg shadow-lime-600/20",
        className,
    ]}
    target="_blank"
    rel="noopener"
>
    {
        icon && (
            <img
                src={icon}
                class="w-5 h-5 md:w-6 md:h-6 brightness-0 invert"
                alt=""
                aria-hidden="true"
            />
        )
    }
    {text}
</a>
