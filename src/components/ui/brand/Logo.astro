---
// UI Brand Logo - Componente refactorizado con <h1> separado del ícono (.webp)
import { useTranslations } from "@i18n/utils";
import type { Locale } from "@i18n/utils";

// Puedes pasarle clases extra si necesitas modificar su tamaño desde el padre
const { class: className } = Astro.props;

// Usar el locale actual o español por defecto
const currentLocale = (Astro.currentLocale || "es") as Locale;
const t = useTranslations(currentLocale);
---

<a href="/" class={`flex items-center gap-3 shrink-0 ${className}`}>
    <img
        src="/icons/update-posadas-navbar-icon.webp"
        alt={t("brand.alt.logo" as any)}
        class="h-10 md:h-12 w-auto"
    />
    <h1
        class="text-xl md:text-3xl font-bold text-slate-900 tracking-normal hidden sm:block"
    >
        {t("brand.name" as any)}
    </h1>
</a>
