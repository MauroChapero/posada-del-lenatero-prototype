---
import type { ShowcaseImage } from "@types";

interface Props extends ShowcaseImage {
    index: number;
}

const { src, alt, class: className, index } = Astro.props;
---

<button
    class:list={[
        "relative overflow-hidden rounded-[2.5rem] border border-neutral-800 bg-neutral-800/30 group cursor-zoom-in outline-none focus:ring-2 focus:ring-lime-600",
        className,
    ]}
    data-gallery-item={index}
    aria-label={`View ${alt}`}
>
    <div
        class="absolute inset-0 bg-linear-to-t from-black/80 via-transparent to-transparent z-10 opacity-60 group-hover:opacity-90 transition-opacity"
    >
    </div>

    <img
        src={src}
        alt={alt}
        class="w-full h-full object-cover transition duration-700 group-hover:scale-105"
        loading="lazy"
    />

    <div
        class="absolute inset-0 z-20 flex flex-col justify-end p-8 text-left translate-y-2 group-hover:translate-y-0 transition-transform"
    >
        <p
            class="text-lime-600 text-[10px] font-bold uppercase tracking-[0.3em] mb-1"
        >
            Explore
        </p>
        <h3 class="text-white text-xl font-bold uppercase tracking-tighter">
            {alt}
        </h3>
    </div>
</button>
