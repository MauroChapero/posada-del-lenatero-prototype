---
interface Props {
  href?: string;
  text?: string;
  className?: string; // Para permitir ajustes extra desde el padre
  variant?: 'primary' | 'outline';
}

const { 
  href = "https://wa.me/5491128171332", 
  text = "Book Now!", 
  className = "",
  variant = 'primary'
} = Astro.props;

// Lógica de estilos por variantes
const baseStyles = "flex-none inline-flex items-center justify-center gap-2 rounded-full font-bold uppercase transition-all duration-200 ease-in-out hover:scale-105 whitespace-nowrap shadow-sm";
const sizeStyles = "px-6 py-3 text-[0.85rem]";

const variants = {
  primary: "bg-[#25d366] text-white hover:bg-[#1ebe57]",
  outline: "border-2 border-[#25d366] text-[#25d366] hover:bg-[#25d366] hover:text-white"
};
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[baseStyles, sizeStyles, variants[variant], className]}
>
  <slot name="icon-before">
    <img
      class="w-5 h-5 brightness-0" 
      src="icons/schedule.webp"
      alt=""
      aria-hidden="true"
    />
  </slot>
  
  {text}

  <slot name="icon-after" />
</a>