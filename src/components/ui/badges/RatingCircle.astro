---
// src/components/ui/RatingCircle.astro
interface Props {
    value: number;
    label: string;
}

const { value, label } = Astro.props;
const degrees = value * 3.6;
---

<div
    class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-full flex items-center justify-center text-sm sm:text-base font-black shadow-lg transition-transform hover:scale-110 duration-300"
    role="progressbar"
    aria-valuenow={value}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-label={label}
    style={`background: conic-gradient(oklch(64.8% 0.2 131.684) ${degrees}deg, #262626 0deg);`}
>
    <div
        class="w-[3.6rem] h-[3.6rem] sm:w-18 sm:h-18 bg-neutral-900 rounded-full flex items-center justify-center"
    >
        {value}%
    </div>
</div>
