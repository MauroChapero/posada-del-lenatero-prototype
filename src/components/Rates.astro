---
import SectionContainer from "./ui/SectionContainer.astro";
---

<SectionContainer id="rates" className="bg-[#f4f4f4] py-16">
    <div class="text-center">
        <h2 class="text-[1.8rem] mb-[0.2rem] font-bold">Available Rates</h2>
        <p class="text-[0.9rem] text-[#555]">Final prices per night</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 my-2.5 gap-x-4">
        <article
            class="bg-white rounded-[15px] p-[1.2rem] flex flex-col items-center shadow-[0_4px_10px_rgba(0,0,0,0.05)]"
        >
            <div class="h-22.5 flex items-center justify-center mb-4">
                <img
                    src="images/rates-beds/single-bed.webp"
                    alt="Single bed"
                    width="86"
                />
            </div>
            <h3 class="text-[1.1rem] font-semibold">Standard Single Room</h3>
            <hr class="w-7.5 my-2.5 border-t border-[#ddd]" />
            <div
                class="mt-auto font-mono tracking-wider bg-[#1a1a1a] text-white text-[1.3rem] font-extrabold px-5 py-2 rounded-full border-2 border-[#25d366]"
            >
                $95 USD
            </div>
        </article>

        <article
            class="bg-white rounded-[15px] p-[1.2rem] flex flex-col items-center shadow-[0_4px_10px_rgba(0,0,0,0.05)]"
        >
            <div class="h-22.5 flex items-center justify-center gap-2 mb-4">
                <img
                    src="images/rates-beds/single-bed.webp"
                    class="w-11.25 h-auto object-contain"
                    alt="Twin 1"
                />
                <img
                    src="images/rates-beds/single-bed.webp"
                    class="w-11.25 h-auto object-contain"
                    alt="Twin 2"
                />
            </div>
            <h3 class="text-[1.1rem] font-semibold">Twin Comfort Room</h3>
            <hr class="w-7.5 my-2.5 border-t border-[#ddd]" />
            <div
                class="mt-auto font-mono tracking-wider bg-[#1a1a1a] text-white text-[1.3rem] font-extrabold px-5 py-2 rounded-full border-2 border-[#25d366]"
            >
                $110 USD
            </div>
        </article>

        <article
            class="bg-white rounded-[15px] p-[1.2rem] flex flex-col items-center shadow-[0_4px_10px_rgba(0,0,0,0.05)]"
        >
            <div class="h-22.5 flex items-center justify-center mb-4">
                <img
                    src="images/rates-beds/single-king-bed.webp"
                    alt="King Single"
                    width="86"
                />
            </div>
            <h3 class="text-[1.1rem] font-semibold">King Single Room</h3>
            <hr class="w-7.5 my-2.5 border-t border-[#ddd]" />
            <div
                class="mt-auto font-mono tracking-wider bg-[#1a1a1a] text-white text-[1.3rem] font-extrabold px-5 py-2 rounded-full border-2 border-[#25d366]"
            >
                $105 USD
            </div>
        </article>
    </div>

    <div class="w-full">
        <article
            class="relative bg-white rounded-[15px] p-4 md:px-10 flex flex-col md:flex-row items-center justify-between shadow-[0_4px_10px_rgba(0,0,0,0.05)] border-2 border-[#25d366]"
        >
            <span
                class="absolute -top-2.5 left-5 mt-2.5 bg-[#25d366] text-white px-3 py-0.5 text-[0.7rem] font-black rounded-full"
            >
                ★ MOST POPULAR
            </span>
            <div class="flex items-center gap-6 text-left">
                <div class="h-22.5 flex items-center mt-3">
                    <img
                        src="images/rates-beds/king-matrimonial-bed.webp"
                        alt="King Matrimonial"
                        width="86"
                    />
                </div>
                <div>
                    <h3 class="text-[1.1rem] font-semibold">
                        King Matrimonial Suite
                    </h3>
                    <p class="text-[0.85rem] text-[#666]">
                        Perfect for couples.
                    </p>
                </div>
            </div>
            <div
                class="font-mono tracking-wider bg-[#25d366] text-black text-[1.3rem] font-extrabold px-5 py-2 rounded-full border-2 border-[#1a1a1a]"
            >
                $125 USD
            </div>
        </article>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-2.5">
        <article
            class="bg-white rounded-[15px] p-[1.2rem] flex flex-col items-center shadow-[0_4px_10px_rgba(0,0,0,0.05)]"
        >
            <div
                class="w-25 h-25 flex flex-wrap justify-center content-center gap-1 mb-4 p-2.5 shadow-inner"
            >
                <img
                    src="images/rates-beds/single-bed.webp"
                    class="w-8.75 h-auto"
                    alt="Bed 1"
                />
                <img
                    src="images/rates-beds/single-bed.webp"
                    class="w-8.75 h-auto"
                    alt="Bed 2"
                />
                <img
                    src="images/rates-beds/single-bed.webp"
                    class="w-8.75 h-auto"
                    alt="Bed 3"
                />
            </div>
            <h3 class="text-[1.1rem] font-semibold text-center">
                Triple Standard Room
            </h3>
            <hr class="w-7.5 my-2.5 border-t border-[#ddd]" />
            <div
                class="mt-auto font-mono tracking-wider bg-[#1a1a1a] text-white text-[1.3rem] font-extrabold px-5 py-2 rounded-full border-2 border-[#25d366]"
            >
                $140 USD
            </div>
        </article>

        <article
            class="bg-white rounded-[15px] p-[1.2rem] flex flex-col items-center shadow-[0_4px_10px_rgba(0,0,0,0.05)]"
        >
            <div class="h-22.5 flex items-center justify-center gap-2 mb-4">
                <img
                    src="images/rates-beds/king-matrimonial-bed.webp"
                    class="w-17.5 h-auto"
                    alt="King bed"
                />
                <img
                    src="images/rates-beds/single-bed.webp"
                    class="w-11.25 h-auto mt-4"
                    alt="Single bed"
                />
            </div>
            <h3 class="text-[1.1rem] font-semibold">Triple Deluxe Room</h3>
            <hr class="w-7.5 my-2.5 border-t border-[#ddd]" />
            <div
                class="mt-auto font-mono tracking-wider bg-[#1a1a1a] text-white text-[1.3rem] font-extrabold px-5 py-2 rounded-full border-2 border-[#25d366]"
            >
                $140 USD
            </div>
        </article>

        <article
            class="bg-white rounded-[15px] p-[1.2rem] flex flex-col items-center shadow-[0_4px_10px_rgba(0,0,0,0.05)]"
        >
            <div
                class="w-25 h-25 flex flex-col items-center justify-center gap-1 mb-5 my-2.5"
            >
                <img
                    src="images/rates-beds/king-matrimonial-bed.webp"
                    class="w-17.5 h-auto"
                    alt="King"
                />
                <div class="flex gap-1 justify-center">
                    <img
                        src="images/rates-beds/single-bed.webp"
                        class="w-8.75 h-auto"
                        alt="Child 1"
                    />
                    <img
                        src="images/rates-beds/single-bed.webp"
                        class="w-8.75 h-auto"
                        alt="Child 2"
                    />
                </div>
            </div>
            <h3 class="text-[1.1rem] font-semibold">Family Suite (4 guests)</h3>
            <hr class="w-7.5 my-2.5 border-t-2 border-red-500" />
            <div
                class="mt-auto font-mono tracking-wider bg-[#1a1a1a] text-white text-[1.3rem] font-extrabold px-5 py-2 rounded-full border-2 border-[#25d366]"
            >
                US$ 150
            </div>
        </article>
    </div>
</SectionContainer>
