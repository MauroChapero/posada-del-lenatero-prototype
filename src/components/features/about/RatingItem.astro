---
// src/components/ui/RatingItem.astro
import type { Rating } from "@types";
import RatingCircle from "@ui/badges/RatingCircle.astro";

interface Props extends Rating {}

const { title, label, value, note } = Astro.props;
---

<li class="flex flex-col items-center sm:items-start gap-3 md:gap-4">
    <RatingCircle value={value} label={label} />

    <div class="text-center sm:text-left">
        <p
            class="font-bold uppercase text-[10px] sm:text-sm tracking-wide text-white leading-tight"
        >
            {title}
        </p>
        <p
            class="text-[10px] sm:text-xs text-lime-600 font-medium mt-1 uppercase tracking-tighter"
        >
            {note}
        </p>
    </div>
</li>
