---
interface Props {
    src: string;
    alt: string;
}
const { src, alt } = Astro.props;
---

<div class="absolute inset-0 -z-10">
    <picture class="absolute inset-0 w-full h-full">
        <img
            src={src}
            alt={alt}
            class="w-full h-full object-cover object-center"
        />
    </picture>
    <div
        class="absolute inset-0 bg-black/40 md:bg-linear-to-r md:from-black/60 md:to-transparent"
    >
    </div>
</div>
