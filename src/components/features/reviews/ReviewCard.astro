---
import type { Review } from "@types";
import { Icon } from "astro-icon/components";
import Stars from "@ui/badges/Stars.astro";
import { useTranslations, getCountryName } from "@i18n/utils";
import type { Locale } from "@i18n/utils";

interface Props {
    review: Review;
    locale: Locale;
}

const { review, locale } = Astro.props;
const t = useTranslations(locale);
const localizedCountry = getCountryName(review.countryCode, locale);
---

<div
    class="review-card group flex flex-col bg-white p-6 md:p-10 rounded-4xl md:rounded-[2.5rem] border-2 border-gray-100 transition-all duration-500 hover:border-lime-600 hover:-translate-y-2 hover:shadow-2xl hover:shadow-lime-600/10 min-h-80 relative overflow-hidden"
>
    <div
        class="absolute top-0 left-0 w-full h-1 bg-lime-600 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
    >
    </div>
    <div class="flex justify-between items-start mb-6">
        <Stars />
        <span
            class="text-xs text-gray-400 font-bold uppercase tracking-widest italic"
            >{review.date}</span
        >
    </div>

    <h3
        class="text-xl md:text-2xl font-bold text-gray-900 mb-3 group-hover:text-lime-600 transition-colors duration-300"
    >
        "{review.title}"
    </h3>

    <div class="grow">
        <p
            class="review-message text-sm md:text-base text-[#555] leading-relaxed font-normal opacity-95 line-clamp-4 transition-all duration-700"
        >
            {review.message}
        </p>
    </div>

    <div class="flex items-center gap-4 pt-6 border-t border-gray-100 mt-6">
        <div class="relative shrink-0">
            <div
                class="w-12 h-12 rounded-2xl bg-gray-50 flex items-center justify-center text-gray-900 font-bold text-lg border-2 border-transparent group-hover:border-lime-600 group-hover:bg-white transition-all duration-500 shadow-sm"
            >
                {review.name.charAt(0)}
            </div>

            <div class="absolute -bottom-2 -right-2 drop-shadow-md">
                <Icon
                    name={`circle-flags:${review.countryCode}`}
                    class="w-6 h-6"
                />
            </div>
        </div>

        <div>
            <p
                class="font-bold text-gray-900 text-sm uppercase tracking-wider leading-none mb-1"
            >
                {review.name}
            </p>
            <p class="text-xs text-gray-500 font-medium italic">
                {t("reviews.guestFrom")} {localizedCountry}
            </p>
        </div>
    </div>
</div>
