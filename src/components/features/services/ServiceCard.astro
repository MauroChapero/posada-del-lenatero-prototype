---
import type { Service } from "@types";
import { useTranslations } from "@i18n/utils";
import type { Locale } from "@i18n/utils";

interface Props {
    service: Service;
    locale: Locale;
}

const { service, locale } = Astro.props;
const t = useTranslations(locale);
---

<div
    class="group relative bg-white p-8 md:p-10 rounded-[2.5rem] border border-gray-100 transition-all duration-500 flex flex-col md:flex-row items center md:items-start gap-8 hover:-translate-y-1"
>
    <div class="relative shrink-0 mx-auto md:mx-0">
        <div
            class="relative w-20 h-20 flex items-center justify-center rounded-2xl bg-gray-50 group-hover:bg-lime-600 transition-all duration-500 group-hover:ring-1 group-hover:ring-gray-900"
        >
            <img
                src={`/icons/services/${service.icon}.webp`}
                alt=`${service.name}`
                class="w-10 h-10 object-contain group-hover:brightness-0 group-hover:invert transition-all duration-500"
                loading="lazy"
            />
        </div>
    </div>

    <div class="text-center md:text-left flex-1">
        <div
            class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 mb-3 justify-center md:justify-start"
        >
            <h3
                class="text-2xl font-bold text-gray-900 group-hover:text-lime-600 transition-colors duration-300"
            >
                {service.name}
            </h3>
            {
                service.isAdditional && !service.hasCta && (
                    <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-lime-600 text-white border border-lime-600 shrink-0">
                        {t("services.additional" as any)}
                    </span>
                )
            }
            {
                service.hasCta && (
                    <a 
                        href="https://wa.me/5491128171332" 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-full bg-lime-600 text-white border border-lime-600 shrink-0 hover:bg-lime-700 transition-colors shadow-sm"
                    >
                        <img src="/icons/whatsapp-icon.svg" alt="WhatsApp" class="w-3.5 h-3.5 invert brightness-0" />
                        Consulte promos vigentes
                    </a>
                )
            }
        </div>
        {service.description && (
            <p class="text-base text-[#555] leading-relaxed font-normal italic opacity-95">
                {service.description}
            </p>
        )}
    </div>
</div>
