---
import type { Service } from "@types";

interface Props {
    service: Service;
}

const { service } = Astro.props;
---

<div
    class="group relative bg-white p-8 md:p-10 rounded-[2.5rem] border border-gray-100 transition-all duration-500 flex flex-col md:flex-row items center md:items-start gap-8 hover:-translate-y-1"
>
    <div class="relative shrink-0">
        <div
            class="relative w-20 h-20 flex items-center justify-center rounded-2xl bg-gray-50 group-hover:bg-lime-600 transition-all duration-500 group-hover:ring-1 group-hover:ring-gray-900"
        >
            <img
                src={`/icons/services/${service.icon}.webp`}
                alt=`${service.name}`
                class="w-10 h-10 object-contain group-hover:brightness-0 group-hover:invert transition-all duration-500"
                loading="lazy"
            />
        </div>
    </div>

    <div class="text-center md:text-left">
        <h3
            class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-lime-600 transition-colors duration-300"
        >
            {service.name}
        </h3>
        <p
            class="text-base text-[#555] leading-relaxed font-normal italic opacity-95"
        >
            {service.description}
        </p>
    </div>
</div>
